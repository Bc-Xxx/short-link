# ──────────────────────────────────────
# 短链接服务 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ──────────────────────────────────────

# 数据库地址（开发环境用 SQLite，生产环境用 PostgreSQL）
DATABASE_URL=sqlite:///./shortlink.db

# JWT 密钥（生产环境请换成随机长字符串！）
SECRET_KEY=your-secret-key-change-in-production

# JWT 签名算法
ALGORITHM=HS256

# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 通义千问 API Key（AI 安全分析用）
# 去 https://help.aliyun.com/zh/model-studio/ 申请
DASHSCOPE_API_KEY=your-dashscope-api-key

# 部署域名（短链接的完整地址前缀）
# 本地开发保持默认，上线后改成你的域名
BASE_URL=http://localhost:8000
